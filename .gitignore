# Local environments and disposable caches
.venv/
.cache/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
build/
dist/
.DS_Store

# Credentials stay local
.env
.env.*
!.env.example
kaggle.json
.kaggle/

# Large inputs stay local; small reference data stays in Git
data/*
!data/.gitkeep
!data/references/
data/references/downloads/

# Run outputs and full CSVs stay local
outputs/*
!outputs/.gitkeep

# Editor scratch files
.ipynb_checkpoints/
*.log
*.tmp
*.temp
*.swp
*.swo
*~
